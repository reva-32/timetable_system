MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
DB_NAME=TimeTable

# Flask session signing. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
# Leave blank when the Flask app serves the frontend from the same origin.
FRONTEND_ORIGIN=
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
MAX_UPLOAD_SIZE_MB=10

# Only used by migrate_users.py to initialize legacy accounts without a password.
MIGRATION_DEFAULT_PASSWORD=replace-with-a-strong-temporary-password

# Coordinator bootstrap. Existing passwords are never overwritten.
COORDINATOR_EMAIL=coordinator@pict.edu
COORDINATOR_PASSWORD=replace-with-a-strong-password
COORDINATOR_NAME=Examination Coordinator
COORDINATOR_DEPARTMENT=IT

# Duty demand defaults (the UI can override per generation).
MAX_DUTIES=5
JS_PER_SESSION=0
SQUAD_PER_SESSION=9
LAST_DAY_SQUAD=2
JS_REPORTING_MINUTES=30
SQUAD_REPORTING_MINUTES=40
CONTROL_ROOM=Room A1-110

# Direct moves change a day's headcount, so mutual swaps are the default.
ALLOW_DIRECT_MOVE=false

# ---------------------------------------------------------------------------
# Outgoing email (faculty duty reports + daily change reports)
# ---------------------------------------------------------------------------
# With "auto", email starts working as soon as SMTP_HOST and SMTP_FROM_EMAIL
# (or SMTP_USERNAME) are filled in. Use false to disable it explicitly.
MAIL_ENABLED=auto

# Every faculty member still gets a separate personalized message and report.
# In demo/test mode only the delivery address is redirected here; the subject
# and body still name the real intended faculty member. Set to false when the
# real @pict.edu faculty mailboxes are ready.
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=dhairyajotwani5@gmail.com

# true = return immediately and send in a background worker.
MAIL_ASYNC=true
# true = do not contact SMTP; write complete .eml files under generated_reports/mail_outbox.
MAIL_DRY_RUN=false
MAIL_SEND_DAILY_CHANGES=true

# SMTP example for Gmail: smtp.gmail.com, 587, TLS, and a Google App Password
# (not the normal account password). Replace with the PICT mail relay for real use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PICT Examination Cell
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
MAIL_REPLY_TO=

# Daily change reports are emailed to this comma-separated list. If empty and
# test mode is on, they go to MAIL_TEST_RECIPIENT. COE_EMAIL/PRINCIPAL_EMAIL are
# used as a fallback when this is empty.
REPORT_RECIPIENTS=

# ---------------------------------------------------------------------------
# Report identity and signature blocks
# ---------------------------------------------------------------------------
INSTITUTE_NAME=Pune Institute of Computer Technology (PICT)
COE_NAME=Controller of Examinations
COE_TITLE=Controller of Examinations (COE)
COE_EMAIL=
PRINCIPAL_NAME=Principal
PRINCIPAL_TITLE=Principal
PRINCIPAL_EMAIL=

# Optional PNG/JPG signature images. Relative paths are resolved from backend/.
# When empty, a clearly marked "DIGITALLY SIGNED" text block is used instead.
COE_SIGNATURE_IMAGE=
PRINCIPAL_SIGNATURE_IMAGE=

# Generated Word/Excel reports are stored here (relative to backend/).
REPORT_OUTPUT_DIR=generated_reports
